---
import Container from "@/components/container.astro";
import type { Lang } from "@/i18n/utils";

const { lang = "zh" } = Astro.props as { lang?: Lang };
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-rule)] py-12 mt-8">
  <Container>
    <div class="flex flex-col md:flex-row justify-between items-center gap-6">
      <!-- Left: Logo & Description -->
      <div class="text-center md:text-left">
        <p class="font-serif font-bold text-[var(--color-ink)] mb-1">AI+X</p>
        <p class="text-xs text-[var(--color-muted)]">
          {lang === "zh"
            ? "连接人工智能、科学研究与真实应用的学术交流平台"
            : "A platform connecting AI, scientific research, and real-world applications"}
        </p>
      </div>

      <!-- Right: Copyright -->
      <div class="shrink-0 text-center md:text-right">
        <p class="text-xs text-[var(--color-muted)]">
          © {year} AI+X
        </p>
        <p class="text-xs text-[var(--color-muted)] mt-0.5">
          {lang === "zh" ? "保留所有权利" : "All rights reserved"}
        </p>
      </div>
    </div>
  </Container>
</footer>
