---
import Container from "@/components/container.astro";
import {
  useTranslations,
  switchLangPath,
  withBase,
  type Lang,
} from "@/i18n/utils";

const { lang = "zh" } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);

const prefix = lang === "en" ? "/en" : "";
const menuitems = [
  { title: t("nav.home"), path: prefix + "/" },
  { title: lang === "zh" ? "基础信息" : "Basic Info", path: prefix + "/about" },
  { title: t("nav.talks"), path: prefix + "/talks" },
  { title: lang === "zh" ? "观众须知" : "Audience", path: prefix + "/audience" },
  { title: lang === "zh" ? "讲者须知" : "For Speakers", path: prefix + "/speaker" },
  { title: lang === "zh" ? "讲者报名" : "Apply", path: prefix + "/signup" },
  { title: t("nav.contact"), path: prefix + "/contact" },
];

const otherLang: Lang = lang === "zh" ? "en" : "zh";
const otherLangLabel = lang === "zh" ? "EN" : "中";
const otherLangPath = switchLangPath(Astro.url, otherLang);
const homePath = withBase(prefix + "/");
---

<header class="border-b border-[var(--color-rule)] sticky top-0 bg-[var(--color-paper)] z-50">
  <Container>
    <div class="flex items-center justify-between gap-6 min-h-24 sm:min-h-28 py-2">
      <!-- Logo -->
      <a href={homePath} class="shrink-0" aria-label={lang === "zh" ? "AI+X 首页" : "AI+X home"}>
        <img
          class="brand-logo"
          src={withBase("/logo.png")}
          alt="AI+X"
          width="1274"
          height="502"
          fetchpriority="high"
          decoding="async"
        />
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden xl:flex items-center gap-6" aria-label={lang === "zh" ? "主导航" : "Main navigation"}>
        {menuitems.map((item) => (
          <a
            href={withBase(item.path)}
            class="whitespace-nowrap text-base text-[var(--color-slate)] hover:text-[var(--color-accent)] transition border-b border-transparent hover:border-[var(--color-accent)] pb-0.5">
            {item.title}
          </a>
        ))}
      </nav>

      <!-- Language Toggle -->
      <div class="flex shrink-0 items-center gap-3">
        <a
          href={withBase(otherLangPath)}
          aria-label="Switch language"
          class="inline-flex items-center justify-center w-9 h-9 text-sm font-mono font-medium text-[var(--color-slate)] hover:text-[var(--color-accent)] border border-[var(--color-rule)] rounded hover:border-[var(--color-accent)] transition">
          {otherLangLabel}
        </a>

        <!-- Mobile menu button -->
        <button
          class="xl:hidden p-2 text-[var(--color-slate)]"
          aria-label={lang === "zh" ? "导航菜单" : "Navigation menu"}
          aria-controls="mobile-menu"
          aria-expanded="false"
          id="mobile-menu-btn">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Nav -->
    <nav class="xl:hidden hidden pb-4" id="mobile-menu" aria-label={lang === "zh" ? "移动端导航" : "Mobile navigation"}>
      <div class="flex flex-col gap-2">
        {menuitems.map((item) => (
          <a
            href={withBase(item.path)}
            class="text-base text-[var(--color-slate)] hover:text-[var(--color-accent)] py-1">
            {item.title}
          </a>
        ))}
      </div>
    </nav>
  </Container>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    if (!menu) return;
    const isHidden = menu.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!isHidden));
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu && !menu.classList.contains('hidden')) {
      menu.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
      btn?.focus();
    }
  });
</script>

<style>
  .brand-logo {
    display: block;
    width: 160px;
    height: auto;
    /* Keep the supplied artwork intact and blend its white canvas into the header. */
    mix-blend-mode: multiply;
  }

  @media (min-width: 640px) {
    .brand-logo {
      width: 208px;
    }
  }
</style>
