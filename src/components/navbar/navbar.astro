---
import Container from "@/components/container.astro";
import {
  useTranslations,
  switchLangPath,
  withBase,
  type Lang,
} from "@/i18n/utils";

const { lang = "zh" } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);

const prefix = lang === "en" ? "/en" : "";
const menuitems = [
  { title: t("nav.home"), path: prefix + "/" },
  { title: t("nav.about"), path: prefix + "/about" },
  { title: t("nav.talks"), path: prefix + "/talks" },
  { title: t("nav.contact"), path: prefix + "/contact" },
];

const otherLang: Lang = lang === "zh" ? "en" : "zh";
const otherLangLabel = lang === "zh" ? "EN" : "中";
const otherLangPath = switchLangPath(Astro.url, otherLang);
const homePath = withBase(prefix + "/");
const sloganParts = lang === "zh" ? t("hero.slogan").split(/(?<=，)/u) : [t("hero.slogan")];
---

<header class="border-b border-[var(--color-rule)] sticky top-0 bg-[var(--color-paper)] z-50">
  <Container>
    <div class="header-layout">
      <!-- Logo -->
      <a href={homePath} class="header-brand" aria-label={lang === "zh" ? "AI+X 首页" : "AI+X home"}>
        <img
          class="brand-logo"
          src={withBase("/logo.png")}
          alt="AI+X"
          width="1274"
          height="502"
          fetchpriority="high"
          decoding="async"
        />
      </a>

      <p class="brand-slogan">{sloganParts.map((part) => <span>{part}</span>)}</p>

      <div class="header-controls">
        <!-- Desktop Nav -->
        <nav class="hidden md:flex items-center gap-6" aria-label={lang === "zh" ? "主导航" : "Main navigation"}>
          {menuitems.map((item) => (
            <a
              href={withBase(item.path)}
              class="whitespace-nowrap text-base text-[var(--color-slate)] hover:text-[var(--color-accent)] transition border-b border-transparent hover:border-[var(--color-accent)] pb-0.5">
              {item.title}
            </a>
          ))}
        </nav>

        <!-- Language Toggle -->
        <div class="flex shrink-0 items-center gap-3">
          <a
            href={withBase(otherLangPath)}
            aria-label="Switch language"
            class="inline-flex items-center justify-center w-9 h-9 text-sm font-mono font-medium text-[var(--color-slate)] hover:text-[var(--color-accent)] border border-[var(--color-rule)] rounded hover:border-[var(--color-accent)] transition">
            {otherLangLabel}
          </a>

          <!-- Mobile menu button -->
          <button
            class="md:hidden p-2 text-[var(--color-slate)]"
            aria-label={lang === "zh" ? "导航菜单" : "Navigation menu"}
            aria-controls="mobile-menu"
            aria-expanded="false"
            id="mobile-menu-btn">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Nav -->
    <nav class="md:hidden hidden pb-4" id="mobile-menu" aria-label={lang === "zh" ? "移动端导航" : "Mobile navigation"}>
      <div class="flex flex-col gap-2">
        {menuitems.map((item) => (
          <a
            href={withBase(item.path)}
            class="text-base text-[var(--color-slate)] hover:text-[var(--color-accent)] py-1">
            {item.title}
          </a>
        ))}
      </div>
    </nav>
  </Container>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    if (!menu) return;
    const isHidden = menu.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!isHidden));
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu && !menu.classList.contains('hidden')) {
      menu.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
      btn?.focus();
    }
  });
</script>

<style>
  .header-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "brand controls" "slogan slogan";
    align-items: center;
    gap: 0.25rem 0.75rem;
    min-height: 6rem;
    padding: 0.5rem 0 0.75rem;
  }

  .header-brand {
    grid-area: brand;
    width: fit-content;
  }

  .brand-slogan {
    grid-area: slogan;
    min-width: 0;
    font-family: 'Libre Baskerville', Georgia, 'Noto Serif SC', 'Source Han Serif SC', 'Songti SC', STSong, SimSun, serif;
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.7;
    color: var(--color-accent);
    text-wrap: balance;
  }

  .brand-slogan span {
    display: inline-block;
  }

  .header-controls {
    grid-area: controls;
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 1.5rem;
  }

  .brand-logo {
    display: block;
    width: 160px;
    height: auto;
    /* Keep the supplied artwork intact and blend its white canvas into the header. */
    mix-blend-mode: multiply;
  }

  @media (min-width: 640px) {
    .brand-logo {
      width: 208px;
    }
  }

  @media (min-width: 1024px) {
    .header-layout {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas: "brand slogan controls";
      column-gap: 2rem;
      min-height: 7rem;
      padding: 0.5rem 0;
    }

    .brand-slogan {
      max-width: 26rem;
      font-size: 1rem;
    }
  }
</style>
