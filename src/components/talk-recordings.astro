---
import type { Lang } from "@/i18n/utils";

interface Props {
  lang?: Lang;
  recordings: Array<{ label: string; url: string }>;
  wechatReplay?: boolean;
}

const { lang = "zh", recordings, wechatReplay = false } = Astro.props;
const zh = lang === "zh";
const recordingLabel = (label: string) => label === "Bilibili"
  ? (zh ? "B站回放" : "Bilibili replay")
  : label === "YouTube"
    ? (zh ? "YouTube 回放" : "YouTube replay")
    : (zh ? "回放" : "Replay");
---

<div class="talk-recordings">
  {recordings.length > 0 && (
    <nav class="recording-links" aria-label={zh ? "回放平台" : "Replay platforms"}>
      {recordings.map(({ label, url }) => (
        <a href={url} target="_blank" rel="noopener noreferrer">{recordingLabel(label)} <span aria-hidden="true">↗</span></a>
      ))}
    </nav>
  )}
  {wechatReplay && (
    <p class="wechat-replay-note">{zh
      ? "回放也已同步至微信视频号，可从公众号「人工智能交叉研究」进入观看。"
      : "The replay is also available on WeChat Channels. Open it through our official account, 人工智能交叉研究."}</p>
  )}
</div>

<style>
  .talk-recordings { min-width: 0; }
  .recording-links { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .recording-links a { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.65rem 1rem; border-radius: 0.25rem; background: var(--color-accent); color: white; font-size: 0.9375rem; font-weight: 600; line-height: 1.5; text-decoration: none; transition: background-color 150ms ease; }
  .recording-links a:hover { background: var(--color-gold); }
  .recording-links a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  .wechat-replay-note { margin-top: 0.9rem; color: var(--color-muted); font-size: 0.875rem; line-height: 1.75; overflow-wrap: anywhere; }
  .wechat-replay-note:first-child { margin-top: 0; }
</style>
