---
import { useTranslations, withBase, type Lang } from "@/i18n/utils";
import { localizeTalk, type TalkEntry } from "@/utils/talks";

interface Props {
  lang?: Lang;
  talk?: TalkEntry;
}

const { lang = "zh", talk } = Astro.props;
const t = useTranslations(lang);
const zh = lang === "zh";
const prefix = zh ? "" : "/en";
const data = talk ? localizeTalk(talk, lang) : undefined;
const detailUrl = talk ? withBase(`${prefix}/talks/${talk.slug}`) : undefined;
const date = talk?.data.date ?? new Date("2026-11-12T20:00:00+08:00");
const format = (options: Intl.DateTimeFormatOptions) =>
  new Intl.DateTimeFormat(zh ? "zh-CN" : "en-US", {
    ...options,
    timeZone: "Asia/Shanghai",
  }).format(date);
const dateLabel = format({ month: "short", day: "numeric" });
const year = format({ year: "numeric" });
const weekday = format({ weekday: "long" });
const time = format({ hour: "2-digit", minute: "2-digit", hourCycle: "h23" });
const title = data?.title ?? (zh ? "首场 Seminar" : "Our First Seminar");
const abstract = data?.summary ?? data?.abstract ?? (!talk
  ? zh
    ? "从自动化数据分析，到预测与生成建模，再到统计方法的研发，首场报告将连接 AI 的理论问题与研究实践，探讨基础模型为统计研究带来的新可能。"
    : "From automated data analysis and predictive and generative modeling to the development of statistical methods, the first talk connects theoretical questions in AI with research practice and explores new possibilities for foundation models in statistics."
  : undefined);
---

<article class:list={["featured-talk", { "has-portrait": Boolean(data?.speakerImage) }]}>
  <time class="talk-date" datetime={date.toISOString()} aria-label={format({ dateStyle: "full", timeStyle: "short" })}>
    <strong class="date-main">{dateLabel}</strong>
    <span class="date-context"><span>{year}</span><span aria-hidden="true">·</span><span>{weekday}</span></span>
  </time>

  <div class="talk-copy">
    <div class="talk-meta">
      <span class="talk-kind">{talk ? (zh ? "专题学术报告" : "Research Talk") : (zh ? "首场报告 · 预告" : "First Talk · Preview")}</span>
      <span>{time} · {zh ? "北京时间" : "Beijing Time (UTC+8)"}</span>
    </div>
    <h3 class="talk-title">{title}</h3>
    {talk ? (
      <p class="talk-speaker"><strong>{data?.speaker}</strong><span>{data?.affiliation}</span></p>
    ) : (
      <p class="talk-announcement">{zh ? "讲者与报告题目将陆续公布" : "Speaker and talk title to be announced"}</p>
    )}
    {data?.meetingId && <p class="talk-meeting"><span>{zh ? "腾讯会议号" : "Tencent Meeting ID"}</span><strong>{data.meetingId}</strong></p>}
    {abstract && <p class="talk-abstract">{abstract}</p>}
    {!talk && <p class="talk-note">{zh ? `关注微信公众号【${t("contact.wechat.value")}】，获取完整报告信息与参与方式。` : `Follow ${t("contact.wechat.value")} on WeChat for full talk details and participation information.`}</p>}
    <div class="talk-links">
      {talk && <a href={detailUrl}>{zh ? "报告详情" : "Talk details"}<span aria-hidden="true"> →</span></a>}
      {talk?.data.talkInfoUrl && <a href={talk.data.talkInfoUrl} target="_blank" rel="noopener noreferrer">{zh ? "公众号介绍 ↗" : "Announcement ↗"}</a>}
      {talk?.data.paperUrl && <a href={talk.data.paperUrl} target="_blank" rel="noopener noreferrer">{zh ? "论文 ↗" : "Paper ↗"}</a>}
      {talk?.data.slidesUrl && <a href={talk.data.slidesUrl} target="_blank" rel="noopener noreferrer">{zh ? "讲义 ↗" : "Slides ↗"}</a>}
      {talk?.data.videoUrl && <a href={talk.data.videoUrl} target="_blank" rel="noopener noreferrer">{zh ? "回放 ↗" : "Recording ↗"}</a>}
      <a href={talk && (data?.meetingId || data?.groupQr) ? `${detailUrl}#participation` : withBase(`${prefix}/contact#audience`)}>{zh ? "如何参与" : "How to participate"}<span aria-hidden="true"> →</span></a>
    </div>
  </div>
  {data?.speakerImage && (
    <div class="talk-portrait">
      <img src={withBase(data.speakerImage)} alt={zh ? `${data.speaker}的照片` : `Portrait of ${data.speaker}`} width="560" height="860" loading="lazy" decoding="async" />
    </div>
  )}
</article>

<style>
  .featured-talk {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    align-items: start;
    gap: 2rem;
    padding-block: 2rem;
    border-block: 1px solid color-mix(in srgb, var(--color-accent) 20%, transparent);
  }
  .featured-talk.has-portrait { grid-template-columns: 9rem minmax(0, 1fr) 11rem; }
  .talk-portrait { min-width: 0; }
  .talk-portrait img { display: block; width: 100%; height: auto; border-radius: 0.25rem; }
  .talk-date {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    padding-top: 0.15rem;
    color: var(--color-accent);
  }
  .date-main { font-family: var(--font-serif); font-size: 1.75rem; font-weight: 700; line-height: 1.4; letter-spacing: -0.03em; white-space: nowrap; }
  .date-context { display: flex; flex-wrap: wrap; align-items: center; gap: 0.2rem 0.4rem; color: var(--color-muted); font-size: 0.75rem; line-height: 1.6; }
  .talk-copy { min-width: 0; overflow-wrap: anywhere; }
  .talk-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; font-size: 0.875rem; color: var(--color-accent); }
  .talk-kind { font-weight: 600; }
  .talk-title { margin-top: 0.75rem; font-size: clamp(1.5rem, 2.4vw, 1.875rem); line-height: 1.4; overflow-wrap: anywhere; }
  .talk-speaker { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; margin-top: 0.75rem; font-size: 1rem; color: var(--color-slate); }
  .talk-speaker strong { color: var(--color-accent); }
  .talk-meeting { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.75rem; margin-top: 1rem; font-size: 0.9375rem; color: var(--color-accent); }
  .talk-meeting strong { font-family: var(--font-mono); font-size: 1.0625rem; letter-spacing: 0.03em; }
  .talk-announcement { margin-top: 0.5rem; font-size: 0.875rem; color: var(--color-muted); }
  .talk-abstract { margin-top: 1rem; font-size: 1rem; line-height: 1.85; color: var(--color-slate); }
  .talk-note { margin-top: 0.75rem; font-size: 0.875rem; color: var(--color-muted); }
  .talk-links { display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; margin-top: 1.25rem; font-size: 0.9375rem; font-weight: 600; }
  .talk-links a:hover { text-decoration: underline; text-underline-offset: 0.25em; }
  @media (min-width: 640px) and (max-width: 899px) {
    .featured-talk.has-portrait { grid-template-columns: 8rem minmax(0, 1fr); gap: 1.5rem; }
    .has-portrait .talk-date { grid-column: 1; grid-row: 1; }
    .has-portrait .talk-copy { grid-column: 2; grid-row: 1 / 3; }
    .has-portrait .talk-portrait { grid-column: 1; grid-row: 2; }
  }
  @media (max-width: 639px) {
    .featured-talk { grid-template-columns: minmax(0, 1fr); gap: 1.25rem; padding-block: 1.5rem; }
    .featured-talk.has-portrait { grid-template-columns: minmax(0, 1fr) 6.5rem; }
    .has-portrait .talk-date { grid-column: 1; grid-row: 1; }
    .has-portrait .talk-portrait { grid-column: 2; grid-row: 1; }
    .has-portrait .talk-copy { grid-column: 1 / -1; grid-row: 2; }
    .talk-date { align-self: center; padding: 0; }
    .date-main { font-size: 1.5rem; }
  }
</style>
