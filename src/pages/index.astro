---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import { useTranslations, withBase, type Lang } from "@/i18n/utils";
import { getOrganizers, initials } from "@/utils/organizers";

export interface Props {
  lang?: Lang;
}
const { lang = "zh" } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
const prefix = lang === "en" ? "/en" : "";
const organizers = await getOrganizers(lang);

---

<Layout lang={lang}>
  <!-- Hero Section -->
  <section class="py-12 lg:py-16 border-b border-[var(--color-rule)]">
    <Container>
      <div class="flex flex-col lg:flex-row gap-8">
        <div class="flex-1 max-w-3xl">
          <p class="section-marker mb-2">AI+X Seminar · AI 跨学科融合创新研讨会</p>
          <h1 class="hero-title">AI+X Seminar</h1>
          <hr class="rule-accent my-4 w-24" />
          <p class="hero-subtitle mb-6">
            {lang === "zh"
              ? "聚焦 AI 与其他领域的跨学科融合创新，涵盖大模型的数学基础、AI 赋能科学、智能体系统与大模型评测等交叉方向。"
              : "Exploring interdisciplinary innovation between AI and other fields, covering the mathematical foundations of large models, AI for science, agent systems, and large model evaluation."}
          </p>

          <!-- Info Cards - compact -->
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
            <div class="info-card">
              <p class="label">{lang === "zh" ? "主题" : "Theme"}</p>
              <p class="value">{lang === "zh" ? "AI 跨学科融合创新" : "Interdisciplinary AI Innovation"}</p>
            </div>
            <div class="info-card">
              <p class="label">{lang === "zh" ? "时间" : "Time"}</p>
              <p class="value">{lang === "zh" ? "周四晚 8:00 / 周五早 10:00（北京时间）" : "Thursday 8:00 PM / Friday 10:00 AM (Beijing Time, UTC+8)"}</p>
            </div>
            <div class="info-card">
              <p class="label">{lang === "zh" ? "平台" : "Platform"}</p>
              <p class="value">{lang === "zh" ? "哔哩哔哩 · 微信公众号 · 小红书" : "Bilibili · WeChat · Xiaohongshu"}</p>
            </div>
          </div>
        </div>

        <div class="lg:w-[30rem] grid grid-cols-3 gap-5 self-start">
          <div class="border border-[var(--color-rule)] rounded p-4 text-center bg-white">
            <img class="w-36 h-36 mb-3 object-contain bg-white" src={withBase("/qr/wechat.png")} alt={lang === "zh" ? "微信公众号二维码" : "WeChat QR code"} />
            <p class="text-xs text-[var(--color-slate)]">{lang === "zh" ? "微信公众号" : "WeChat OA"}</p>
            <p class="text-[11px] text-[var(--color-muted)] mt-1">AI+X seminar</p>
          </div>
          <div class="border border-[var(--color-rule)] rounded p-4 text-center bg-white">
            <img class="w-36 h-36 mb-3 object-contain bg-white" src={withBase("/qr/bilibili.png")} alt={lang === "zh" ? "哔哩哔哩二维码" : "Bilibili QR code"} />
            <p class="text-xs text-[var(--color-slate)]">{lang === "zh" ? "哔哩哔哩" : "Bilibili"}</p>
            <p class="text-[11px] text-[var(--color-muted)] mt-1">AI+X seminar</p>
          </div>
          <div class="border border-[var(--color-rule)] rounded p-4 text-center bg-white">
            <img class="w-36 h-36 mb-3 object-contain bg-white" src={withBase("/qr/xiaohongshu.png")} alt={lang === "zh" ? "小红书二维码" : "Xiaohongshu QR code"} />
            <p class="text-xs text-[var(--color-slate)]">{lang === "zh" ? "小红书" : "Xiaohongshu"}</p>
            <p class="text-[11px] text-[var(--color-muted)] mt-1">AI+X seminar</p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- This Week's Talk Section -->
  <section class="py-16 border-b border-[var(--color-rule)]">
    <Container>
      <div class="flex items-baseline gap-6 mb-6">
        <h2 class="text-xl">{lang === "zh" ? "本周讲座" : "This Week's Talk"}</h2>
        <span class="section-marker">{lang === "zh" ? "本周讲座" : "This Week's Talk"}</span>
      </div>
      <hr class="rule-subtle mb-0" />
    </Container>
  </section>

  <!-- Schedule Section -->
  <section class="py-16 border-b border-[var(--color-rule)]">
    <Container>
      <div class="flex items-baseline gap-6 mb-6">
        <h2 class="text-xl">{lang === "zh" ? "讲座安排" : "Schedule"}</h2>
        <span class="section-marker">{lang === "zh" ? "按学期归档" : "Schedule by Semester"}</span>
      </div>
      <hr class="rule-subtle mb-0" />

    </Container>
  </section>

  <!-- Organizers Section -->
  <section class="py-16 border-b border-[var(--color-rule)]">
    <Container>
      <div class="flex items-baseline gap-6 mb-6">
        <h2 class="text-xl">{lang === "zh" ? "组织者" : "Organizers"}</h2>
        <span class="section-marker">{lang === "zh" ? "核心团队" : "Core Team"}</span>
      </div>
      <hr class="rule-subtle mb-0" />

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mt-6">
        {organizers.map((org) => (
          <div class="organizer-card">
            {org.avatar ? (
              <img class="avatar" src={org.avatar} alt={org.name} />
            ) : (
              <div class="avatar flex items-center justify-center text-xl font-semibold text-[var(--color-slate)]">
                {initials(org.name)}
              </div>
            )}
            {org.homepage ? (
              <a
                class="name hover:text-[var(--color-accent)] hover:underline underline-offset-4 transition"
                href={org.homepage}
                target="_blank"
                rel="noopener">
                {org.name}
              </a>
            ) : (
              <span class="name">{org.name}</span>
            )}
            <p class="affiliation">{org.affiliation}</p>
          </div>
        ))}
      </div>

      <!-- Contributors -->
      <div class="mt-12 pt-8 border-t border-[var(--color-rule)]">
        <h3 class="text-lg mb-4">{lang === "zh" ? "贡献者" : "Contributors"}</h3>
        <div class="flex flex-wrap gap-2 text-sm text-[var(--color-slate)]">
          {[
            "王子韦", "朱昶宇",
          ].map((name) => (
            <span class="px-3 py-1 bg-[var(--color-paper)] border border-[var(--color-rule)] rounded text-xs">
              {name}
            </span>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <!-- Partners Section -->
  <section class="py-16 border-b border-[var(--color-rule)]">
    <Container>
      <div class="flex items-baseline gap-6 mb-6">
        <h2 class="text-xl">{lang === "zh" ? "合作组织" : "Partners"}</h2>
        <span class="section-marker">{lang === "zh" ? "合作" : "Collaborations"}</span>
      </div>
      <hr class="rule-subtle mb-0" />

    </Container>
  </section>

  <!-- CTA Section -->
  <section class="py-16">
    <Container>
      <div class="max-w-xl mx-auto text-center">
        <h2 class="text-2xl mb-4">{lang === "zh" ? "参与讨论" : "Join the Discussion"}</h2>
        <p class="text-[var(--color-slate)] mb-6">
          {lang === "zh"
            ? "关注微信公众号【AI+X Seminar】发送【加群】获取最新讲座通知与微信群入口。"
            : "Follow our WeChat channel and send [Join] to receive weekly talk notifications."}
        </p>
        <a
          href={withBase(`${prefix}/talks`)}
          class="inline-block px-6 py-3 bg-[var(--color-accent)] text-white font-medium rounded hover:bg-[var(--color-gold)] transition">
          {lang === "zh" ? "查看往期讲座 →" : "View Past Talks →"}
        </a>
      </div>
    </Container>
  </section>
</Layout>
