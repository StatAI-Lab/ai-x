---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import { useTranslations, withBase, type Lang } from "@/i18n/utils";
import { getOrganizers, initials } from "@/utils/organizers";
import { Image } from "astro:assets";
import { siteImages } from "@/utils/images";
import FeaturedTalk from "@/components/featured-talk.astro";
import TalkArchive from "@/components/talk-archive.astro";
import { getTalks } from "@/utils/talks";

export interface Props {
  lang?: Lang;
}
const { lang = "zh" } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
const prefix = lang === "en" ? "/en" : "";
const organizers = await getOrganizers(lang);
const talks = (await getTalks()).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

---

<Layout lang={lang}>
  <!-- AI+X is the platform; seminars are its current activity. -->
  <section class="py-10 lg:py-12">
    <Container>
      <div class="home-featured-column">
        <h1 class="home-intro-title">{t("hero.title")}</h1>
        <div class="home-intro-rule" aria-hidden="true"></div>
        <div class="grid lg:grid-cols-[minmax(0,1fr)_23rem] gap-8 lg:gap-10 items-center">
          <p class="home-intro-description">{t("hero.subtitle")}</p>
          <div class="w-full max-w-lg mx-auto grid grid-cols-3 gap-2 sm:gap-3">
            <div class="min-w-0 border border-[var(--color-rule)] rounded p-2 sm:p-3 text-center bg-white">
              <Image class="w-full max-w-36 h-auto aspect-square mx-auto mb-3 object-contain bg-white" src={siteImages.qr.wechat} alt={lang === "zh" ? "微信公众号二维码" : "WeChat QR code"} width={144} height={144} densities={[1, 2]} format="png" />
              <p class="text-xs text-[var(--color-slate)]">{t("contact.wechat")}</p>
              <p class="text-[11px] text-[var(--color-muted)] mt-1 break-words">{t("contact.wechat.value")}</p>
            </div>
            <div class="min-w-0 border border-[var(--color-rule)] rounded p-2 sm:p-3 text-center bg-white">
              <Image class="w-full max-w-36 h-auto aspect-square mx-auto mb-3 object-contain bg-white" src={siteImages.qr.bilibili} alt={lang === "zh" ? "哔哩哔哩二维码" : "Bilibili QR code"} width={144} height={144} densities={[1, 2]} format="png" />
              <p class="text-xs text-[var(--color-slate)]">{t("contact.bilibili")}</p>
              <p class="text-[11px] text-[var(--color-muted)] mt-1 break-words">{t("contact.bilibili.value")}</p>
            </div>
            <div class="min-w-0 border border-[var(--color-rule)] rounded p-2 sm:p-3 text-center bg-white">
              <Image class="w-full max-w-36 h-auto aspect-square mx-auto mb-3 object-contain bg-white" src={siteImages.qr.xiaohongshu} alt={lang === "zh" ? "小红书二维码" : "Xiaohongshu QR code"} width={144} height={144} densities={[1, 2]} format="png" />
              <p class="text-xs text-[var(--color-slate)]">{t("contact.xiaohongshu")}</p>
              <p class="text-[11px] text-[var(--color-muted)] mt-1 break-words">{t("contact.xiaohongshu.value")}</p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <section class="pt-6 pb-12 lg:pt-8 lg:pb-16 scroll-mt-36" id="discussions">
    <Container>
      <div class="home-featured-column">
        <h2 class="home-section-title">{t("features.title")}</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-8">
          {([3, 4, 5, 6] as const).map((i) => (
            <div class="min-w-0">
              <h3 class="text-base font-semibold border-b border-[var(--color-rule)] pb-3">{t(`features.f${i}.title` as const)}</h3>
              <p class="text-sm text-[var(--color-slate)] leading-relaxed mt-3">{t(`features.f${i}.desc` as const)}</p>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <section class="py-10 lg:py-12 scroll-mt-36" id="first-seminar">
    <Container>
      <div class="home-featured-column">
        <h2 class="home-section-title mb-8">{lang === "zh" ? "报告信息" : "Seminar Talks"}</h2>
        <FeaturedTalk lang={lang} talk={talks[0]} />
        <div class="mt-10">
          <div class="flex flex-wrap items-baseline justify-between gap-3 mb-5">
            <h3 class="text-xl">{lang === "zh" ? "讲座列表" : "Talk Archive"}</h3>
            <a class="text-sm" href={withBase(`${prefix}/talks`)}>{lang === "zh" ? "全部讲座 →" : "All talks →"}</a>
          </div>
          <TalkArchive lang={lang} talks={talks.slice(0, 5)} />
        </div>
      </div>
    </Container>
  </section>

  <!-- Organizers Section -->
  <section class="py-16 border-b border-[var(--color-rule)] scroll-mt-36" id="organizers">
    <Container>
      <div class="home-featured-column">
        <div class="text-center mb-6">
          <h2 class="home-section-title">{lang === "zh" ? "组织者" : "Organizers"}</h2>
          <p class="section-marker mt-2">{lang === "zh" ? "核心团队" : "Core Team"}</p>
        </div>
        <hr class="rule-subtle mb-0" />

        <div class="home-organizer-list">
          {organizers.map((org) => (
            <div class="organizer-card">
              {org.optimizedAvatar ? (
                <Image class="avatar" src={org.optimizedAvatar} alt={org.name} width={80} height={80} densities={[1, 2]} fit="cover" quality="high" loading="lazy" />
              ) : org.avatar ? (
                <img class="avatar" src={org.avatar} alt={org.name} width="80" height="80" loading="lazy" decoding="async" />
              ) : (
                <div class="avatar flex items-center justify-center text-xl font-semibold text-[var(--color-slate)]">
                  {initials(org.name)}
                </div>
              )}
              {org.homepage ? (
                <a
                  class="name hover:text-[var(--color-accent)] hover:underline underline-offset-4 transition"
                  href={org.homepage}
                  target="_blank"
                  rel="noopener">
                  {org.name}
                </a>
              ) : (
                <span class="name">{org.name}</span>
              )}
              <p class="affiliation">{org.affiliation}</p>
            </div>
          ))}
        </div>

        <!-- Contributors -->
        <div class="mt-12 pt-8 border-t border-[var(--color-rule)] text-center">
          <h3 class="text-lg mb-4">{lang === "zh" ? "贡献者" : "Contributors"}</h3>
          <div class="flex flex-wrap justify-center gap-2 text-sm text-[var(--color-slate)]">
            {[
              ...(lang === "zh" ? ["王子韦", "朱昶宇"] : ["Wang Ziwei", "Zhu Changyu"]),
            ].map((name) => (
              <span class="px-3 py-1 bg-[var(--color-paper)] border border-[var(--color-rule)] rounded text-xs">
                {name}
              </span>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- CTA Section -->
  <section class="py-16" id="participate">
    <Container>
      <div class="w-full max-w-xl mx-auto text-center">
        <h2 class="text-2xl mb-4">{lang === "zh" ? "参与讨论" : "Join the Discussion"}</h2>
        <p class="text-[var(--color-slate)] text-balance mb-6">
          {t("cta.desc")}
        </p>
        <a
          href={withBase(`${prefix}/contact#audience`)}
          class="inline-block px-6 py-3 bg-[var(--color-accent)] text-white font-medium rounded hover:bg-[var(--color-gold)] transition">
          {lang === "zh" ? "了解参与方式 →" : "How to Participate →"}
        </a>
      </div>
    </Container>
  </section>
</Layout>

<style>
  .home-section-title {
    font-size: clamp(1.625rem, 2.5vw, 2rem);
    line-height: 1.35;
    text-align: center;
  }

  .home-organizer-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .home-organizer-list .organizer-card {
    width: calc((100% - 1rem) / 2);
    min-width: 0;
  }

  @media (min-width: 768px) {
    .home-organizer-list .organizer-card {
      width: calc((100% - 2rem) / 3);
    }
  }

  @media (min-width: 1024px) {
    .home-organizer-list .organizer-card {
      width: calc((100% - 4rem) / 5);
    }
  }

  .home-featured-column {
    width: 100%;
    max-width: 64rem;
    margin-inline: auto;
    min-width: 0;
  }

  .home-intro-title {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 8vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--color-ink);
  }

  @media (max-width: 359px) {
    .home-intro-title {
      font-size: 2.25rem;
    }
  }

  .home-intro-rule {
    width: 60%;
    max-width: 28rem;
    height: 2px;
    margin: 1.5rem 0;
    background: var(--color-accent);
  }

  .home-intro-description {
    font-size: 1.125rem;
    line-height: 1.85;
    text-wrap: pretty;
    color: var(--color-slate);
  }
</style>
