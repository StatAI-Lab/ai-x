---
import Contactform from "@/components/contactform.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Layout from "@/layouts/Layout.astro";
import { useTranslations, type Lang } from "@/i18n/utils";

export interface Props {
  lang?: Lang;
}
const { lang = "zh" } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
---

<Layout title={t("nav.signup")} lang={lang}>
  <Container>
    <Sectionhead>
      <Fragment slot="title">{t("nav.signup")}</Fragment>
      <Fragment slot="desc">{lang === "zh" ? "在 AI+X 的 Seminar 中分享你的研究" : "Share your research at an AI+X seminar"}</Fragment>
    </Sectionhead>

    <div class="grid md:grid-cols-2 gap-10 mx-auto max-w-4xl mt-16">
      <div>
        <h2 class="font-serif font-semibold text-xl text-[var(--color-ink)]">
          {lang === "zh" ? "成为讲者" : "Become a Speaker"}
        </h2>
        <p class="text-sm leading-relaxed text-[var(--color-slate)] mt-3">
          {lang === "zh"
            ? "欢迎不同研究阶段、不同学科背景的研究者分享工作。除了成熟成果，也欢迎初步发现、研究困惑与开放问题。请通过表单与我们联系。"
            : "We welcome researchers at different career stages and from different disciplines. Share established results, preliminary findings, research challenges, or open questions. Please use the form to contact us."}
        </p>
        <div class="mt-6 space-y-3 text-sm">
          <div class="flex items-center gap-2 text-[var(--color-slate)]">
            <span class="text-[var(--color-accent)]">✦</span>
            <span>{t("contact.wechat")}: {t("contact.wechat.value")}</span>
          </div>
          <div class="flex items-center gap-2 text-[var(--color-slate)]">
            <span class="text-[var(--color-accent)]">✦</span>
            <span>{t("contact.bilibili")}: {t("contact.bilibili.value")}</span>
          </div>
          <div class="flex items-center gap-2 text-[var(--color-slate)]">
            <span class="text-[var(--color-accent)]">✦</span>
            <span>{t("contact.xiaohongshu")}: {t("contact.xiaohongshu.value")}</span>
          </div>
        </div>
      </div>
      <div>
        <Contactform lang={lang} />
      </div>
    </div>
  </Container>
</Layout>
