---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import { useTranslations, withBase, type Lang } from "@/i18n/utils";

const lang: Lang = "en";
const t = useTranslations(lang);
const prefix = "/en";

// Organizers
const organizers = [
  { name: "Fan Zhou", affiliation: "SUFE", homepage: "https://mlzxzhou.github.io/", avatar: "https://api.dicebear.com/7.x/initials/svg?seed=FZ&backgroundColor=9b2335&textColor=ffffff" },
  { name: "Chengchun Shi", affiliation: "LSE", homepage: "https://callmespring.github.io/", avatar: "https://api.dicebear.com/7.x/initials/svg?seed=CS&backgroundColor=9b2335&textColor=ffffff" },
  { name: "Bang Liu", affiliation: "Mila", homepage: "https://mila.quebec/en/directory/bang-liu", avatar: "https://api.dicebear.com/7.x/initials/svg?seed=BL&backgroundColor=9b2335&textColor=ffffff" },
  { name: "Xiaowu Dai", affiliation: "UCLA", homepage: "https://www.xiaowudai.org/", avatar: "https://api.dicebear.com/7.x/initials/svg?seed=XD&backgroundColor=9b2335&textColor=ffffff" },
];

---

<Layout lang={lang}>
  <!-- Hero Section -->
  <section class="py-12 lg:py-16 border-b border-[var(--color-rule)]">
    <Container>
      <div class="flex flex-col lg:flex-row gap-8">
        <div class="flex-1 max-w-3xl">
          <p class="section-marker mb-2">AI+X Seminar · Cross-disciplinary AI</p>
          <h1 class="hero-title">AI+X Seminar</h1>
          <hr class="rule-accent my-4 w-24" />
          <p class="hero-subtitle mb-6">
            Exploring the intersection of AI with other fields, covering AI+Science, cross-modality, and interdisciplinary innovation.
          </p>

          <!-- Info Cards - compact -->
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
            <div class="info-card">
              <p class="label">Theme</p>
              <p class="value">Cross-disciplinary AI</p>
            </div>
            <div class="info-card">
              <p class="label">Time</p>
              <p class="value">Thursday 8:00 PM, Friday 10:00 AM</p>
            </div>
            <div class="info-card">
              <p class="label">Platform</p>
              <p class="value">Bilibili · WeChat · Xiaohongshu</p>
            </div>
          </div>
        </div>

        <div class="lg:w-[30rem] grid grid-cols-3 gap-5 self-start">
          <div class="border border-[var(--color-rule)] rounded p-4 text-center bg-white">
            <img class="w-36 h-36 mb-3 object-contain bg-white" src={withBase("/qr/wechat.png")} alt="WeChat QR code" />
            <p class="text-xs text-[var(--color-slate)]">WeChat OA</p>
            <p class="text-[11px] text-[var(--color-muted)] mt-1">AI+X seminar</p>
          </div>
          <div class="border border-[var(--color-rule)] rounded p-4 text-center bg-white">
            <img class="w-36 h-36 mb-3 object-contain bg-white" src={withBase("/qr/bilibili.png")} alt="Bilibili QR code" />
            <p class="text-xs text-[var(--color-slate)]">Bilibili</p>
            <p class="text-[11px] text-[var(--color-muted)] mt-1">AI+X seminar</p>
          </div>
          <div class="border border-[var(--color-rule)] rounded p-4 text-center bg-white">
            <img class="w-36 h-36 mb-3 object-contain bg-white" src={withBase("/qr/xiaohongshu.png")} alt="Xiaohongshu QR code" />
            <p class="text-xs text-[var(--color-slate)]">Xiaohongshu</p>
            <p class="text-[11px] text-[var(--color-muted)] mt-1">AI+X seminar</p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- News Section -->
  <section class="py-16 border-b border-[var(--color-rule)]">
    <Container>
      <div class="flex items-baseline gap-6 mb-6">
        <h2 class="text-xl">Recent News</h2>
        <span class="section-marker">News</span>
      </div>
      <hr class="rule-subtle mb-0" />
    </Container>
  </section>

  <!-- Schedule Section -->
  <section class="py-16 border-b border-[var(--color-rule)]">
    <Container>
      <div class="flex items-baseline gap-6 mb-6">
        <h2 class="text-xl">Schedule</h2>
        <span class="section-marker">Schedule by Semester</span>
      </div>
      <hr class="rule-subtle mb-0" />

    </Container>
  </section>

  <!-- Organizers Section -->
  <section class="py-16 border-b border-[var(--color-rule)]">
    <Container>
      <div class="flex items-baseline gap-6 mb-6">
        <h2 class="text-xl">Organizers</h2>
        <span class="section-marker">Core Team</span>
      </div>
      <hr class="rule-subtle mb-0" />

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mt-6">
        {organizers.map((org) => (
          <div class="organizer-card">
            <img class="avatar" src={org.avatar} alt={org.name} />
            <a
              class="name hover:text-[var(--color-accent)] hover:underline underline-offset-4 transition"
              href={org.homepage}
              target="_blank"
              rel="noopener">
              {org.name}
            </a>
            <p class="affiliation">{org.affiliation}</p>
          </div>
        ))}
      </div>

      <!-- Contributors -->
      <div class="mt-12 pt-8 border-t border-[var(--color-rule)]">
        <h3 class="text-lg mb-4">Contributors</h3>
        <div class="flex flex-wrap gap-2 text-sm text-[var(--color-slate)]">
          {[
            "Wang Ziwei", "Zhu Changyu",
          ].map((name) => (
            <span class="px-3 py-1 bg-[var(--color-paper)] border border-[var(--color-rule)] rounded text-xs">
              {name}
            </span>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <!-- Partners Section -->
  <section class="py-16 border-b border-[var(--color-rule)]">
    <Container>
      <div class="flex items-baseline gap-6 mb-6">
        <h2 class="text-xl">Partners</h2>
        <span class="section-marker">Collaborations</span>
      </div>
      <hr class="rule-subtle mb-0" />

    </Container>
  </section>

  <!-- CTA Section -->
  <section class="py-16">
    <Container>
      <div class="max-w-xl mx-auto text-center">
        <h2 class="text-2xl mb-4">Join the Discussion</h2>
        <p class="text-[var(--color-slate)] mb-6">
          Follow our WeChat channel and send [Join] to receive weekly talk notifications.
        </p>
        <a
          href={withBase(`${prefix}/talks`)}
          class="inline-block px-6 py-3 bg-[var(--color-accent)] text-white font-medium rounded hover:bg-[var(--color-gold)] transition">
          View Past Talks →
        </a>
      </div>
    </Container>
  </section>
</Layout>
