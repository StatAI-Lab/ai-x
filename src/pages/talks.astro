---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import FeaturedTalk from "@/components/featured-talk.astro";
import TalkArchive from "@/components/talk-archive.astro";
import { useTranslations, type Lang } from "@/i18n/utils";
import { getTalks } from "@/utils/talks";

export interface Props {
  lang?: Lang;
}
const { lang = "zh" } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
const allTalks = await getTalks();
allTalks.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title={t("nav.talks")} lang={lang}>
  <Container>
    <div class="talks-column">
      <Sectionhead>
        <Fragment slot="title">{t("talks.title")}</Fragment>
        <Fragment slot="desc">{t("talks.desc")}</Fragment>
      </Sectionhead>

      <section class="mt-12 lg:mt-16" aria-labelledby="recent-talk-title">
        <h2 id="recent-talk-title" class="talks-section-title">{lang === "zh" ? "近期报告" : "Recent Talk"}</h2>
        <FeaturedTalk lang={lang} talk={allTalks[0]} />
      </section>

      <section class="mt-14 lg:mt-16 mb-16" aria-labelledby="talk-archive-title">
        <h2 id="talk-archive-title" class="talks-section-title">{lang === "zh" ? "讲座列表" : "Talk Archive"}</h2>
        <TalkArchive lang={lang} talks={allTalks} />
      </section>
    </div>
  </Container>
</Layout>

<style>
  .talks-column {
    width: 100%;
    max-width: 64rem;
    margin-inline: auto;
    min-width: 0;
  }

  .talks-section-title {
    margin-bottom: 1.5rem;
    font-size: clamp(1.625rem, 2.5vw, 2rem);
    line-height: 1.35;
  }
</style>
